%?if(%sd,=,1)<%?if(%an(16,55),=,16)<%Vd(gg15)>>
#
%Vl(gg00,60,436,51,4,-)
%Vt(0)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(gg01,111,436,51,4,-)
