%?if(%sd,=,0)<%Vd(q1)>
%?if(%sd,=,0)<%Vd(q2)>
%?if(%sd,=,0)<%Vd(q3)>
%?if(%sd,=,0)<%Vd(q4)>
%?mp<|%?if(%an(16,70),=,1)<%Vd(ch00)>|||||>
%?mp<|%?if(%an(16,70),=,2)<%Vd(ch01)>|||||>
%?mp<|%?if(%an(16,70),=,3)<%Vd(ch02)>|||||>
%?mp<|%?if(%an(16,70),=,4)<%Vd(ch03)>|||||>
%?mp<|%?if(%an(16,70),=,5)<%Vd(ch04)>|||||>
