%?mp<|%?if(%an(16,70),=,7)<%Vd(ch06)>|||||>
%?mp<|%?if(%an(16,70),=,8)<%Vd(ch07)>|||||>
%?mp<|%?if(%an(16,70),=,9)<%Vd(ch08)>|||||>
%?mp<|%?if(%an(16,70),=,10)<%Vd(ch09)>|||||>
%?mp<|%?if(%an(16,70),=,11)<%Vd(ch10)>|||||>
%?mp<|%?if(%an(16,70),=,12)<%Vd(ch11)>|||||>
%?mp<|%?if(%an(16,70),=,13)<%Vd(ch12)>|||||>
%?mp<|%?if(%an(16,70),=,14)<%Vd(ch13)>|||||>
%?mp<|%?if(%an(16,70),=,15)<%Vd(ch14)>|||||>
%?mp<|%?if(%an(16,70),=,16)<%Vd(ch15)>|||||>
%?if(%an(10,90),=,1)<%Vd(sh0)>
%?if(%an(10,90),=,2)<%Vd(sh1)>
%?if(%an(10,90),=,3)<%Vd(sh2)>
%?if(%an(10,90),=,4)<%Vd(sh3)>
%?if(%an(10,90),=,5)<%Vd(sh4)>
%?if(%an(10,90),=,6)<%Vd(sh5)>
%?if(%an(10,90),=,7)<%Vd(sh6)>
%?if(%an(10,90),=,8)<%Vd(sh7)>
%?if(%an(10,90),=,9)<%Vd(sh8)>
%?if(%an(10,90),=,10)<%Vd(sh9)>
%?if(%an(8,110),=,1)<%Vd(pu0)>
%?if(%an(8,110),=,2)<%Vd(pu1)>
%?if(%an(8,110),=,3)<%Vd(pu2)>
%?if(%an(8,110),=,4)<%Vd(pu3)>
%?if(%an(8,110),=,5)<%Vd(pu4)>
%?if(%an(8,110),=,6)<%Vd(pu5)>
%?if(%an(8,110),=,7)<%Vd(pu6)>
