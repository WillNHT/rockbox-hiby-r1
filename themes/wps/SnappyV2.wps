%Vl(vdrim,27,23,144,24,-)
%dr(0,0,-,2,D9E021,D9E021)
%dr(0,22,-,2,D9E021,D9E021)
%dr(0,0,2,-,D9E021,D9E021)
%dr(142,0,2,-,D9E021,D9E021)
