%?if(%sd,=,1)<%?if(%an(12,60),=,11)<%Vd(vd10)>>
%?if(%sd,=,1)<%?if(%an(12,60),=,12)<%Vd(vd11)>>
#
%Vl(vdrim,27,107,426,42,-)
%dr(0,0,-,2,D9E021,D9E021)
%dr(0,40,-,2,D9E021,D9E021)
%dr(0,0,2,-,D9E021,D9E021)
%dr(424,0,2,-,D9E021,D9E021)
#
%Vl(vd00,30,107,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd01,114,107,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd02,198,107,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd03,282,107,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd04,366,107,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd05,450,110,3,36,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd06,366,146,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd07,282,146,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd08,198,146,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd09,114,146,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd10,30,146,84,3,-)
%dr(0,0,-,-,D9E021,F4F2EE)
%Vl(vd11,27,110,3,36,-)
%dr(0,0,-,-,D9E021,F4F2EE)
#
# Header
# ======
# Sleep timer
%Vl(sleep,30,30,110,62,2)
%Vs(invert)%ac%bs
%aczzz...
#
# Volume (percent of the -70..-10 dB scale)
%Vl(voldb,30,30,110,62,4)
%Vs(invert)%ac%pv
#
# Shuffle
%V(174,28,94,22,2)
SHF%xd(O,%ps)
#
# Repeat
%V(174,58,94,22,2)
%?mm<RPT%xd(Ob)|RPT%xd(O)|RP1%xd(O)|RND%xd(O)|A-B%xd(O)>
