#
#  Snappy V2 status bar - Chris Soffke's Snappy 1.3 SBS, unchanged except
#  for the font, which is Geist Mono here so that Vietnamese renders.
#
#  ____ _  _ ____ ___  ___  _   _
#  [__  |\ | |__| |__] |__]  \_/
#  ___] | \| |  | |    |      |
#
#  v 1.3 2026
#  Chris Soffke
#  CC-BY-SA
#
#  480x800 version, mechanically scaled 2x from the author's 240x320
#  release (coordinates, bitmaps, and font sizes). The layout is
#  unchanged; fonts were re-rendered from Kode Mono at 2x size.
#
#  Remix of Simon Andén's SNARTY, rewritten for 240x320px.
#
#  Based on original design by
#  Chuck Lardo (SPAZZ), plus further work by
#  Jihoon Kim (SNAZZ/SNAZZ2),
#  Phil Graves (SNAZZY), and
#  Evan Dook (Adwaitapod)
#
%Fl(3,31-GeistMono-SemiBold.fnt)
%Fl(4,44-GeistMono-SemiBold.fnt)
%Fl(5,58-GeistMono-SemiBold.fnt)
%xl(batt,batt_sbs.bmp,114,6,11)
%xl(batt_chg,batt_sbs_chg.bmp,114,6)
# The icons left of the battery, 28 px apart: the rune, Wi-Fi, then whatever
# else is on, each in the first place free - so nothing stands off on its own.
%xl(bt,bt.bmp,86,6,4)
%xl(wifi,wifi.bmp,58,6,3)
%xl(lock,lock.bmp,30,6,2)
%xl(wired,wired.bmp,30,6)
%xl(wired2,wired.bmp,2,6)
%xl(rx,rx.bmp,30,6,2)
%xl(rx2,rx.bmp,2,6,2)
%xl(db,db.bmp,30,6,2)
%xl(db2,db.bmp,2,6,2)
%xl(p,paused.bmp,12,8)
%xl(vb,vb.bmp)
%xl(vb_backdrop,vb_backdrop.bmp)
%xl(vb_too_loud,vb_too_loud.bmp)
# With the plate up the title shares the status row instead of taking one of
# its own (title_p), and main_p
# starts that much higher.
%?mv(1.5)<%Vd(vol)|%?and(%if(%St(touchscreen mode),=,stick),%if(%St(stick overlay),=,on),%if(%St(stick overlay style),=,plate))<%?Lt<%Vd(title_p)%Vd(rule_p)|%Vd(status)%Vd(no_title)>|%Vd(status)%?Lt<%Vd(title)|%Vd(no_title)>>>
# The bottom 338 px are the joystick plate's (PLATE_H in apps/stick_glue.c),
# but only while the settings would draw one: main_p ends right above it and
# there is no now-playing footer, the plain viewports use the whole panel.
%?if(%cs, =, 21)<%Vd(USB)%VI(USB)|%?and(%if(%St(touchscreen mode),=,stick),%if(%St(stick overlay),=,on),%if(%St(stick overlay style),=,plate))<%VI(main_p)|%?mp<%VI(main_l)%Vd(main_l)|%VI(main)%Vd(main)>>>
%?if(%cs, =, 21)<|%?mp<|%?and(%if(%St(touchscreen mode),=,stick),%if(%St(stick overlay),=,on),%if(%St(stick overlay style),=,plate))<|%?C<%Vd(npart)|%Vd(npnote)>>>>
#
# ---------
# Margins
# ---------
# t (also displays disk activity)
%V(0,0,-30,30,3)
%?if(%lh,=,h)<%ar%t(0.5);%ar%t(0.5).;%ar%t(0.5)..;%ar%t(0.5)...|       >
# l
%V(0,0,30,-,-)
# r
%V(-30,0,-,-,-)
# b (when footer is hidden)
%Vl(main_l,30,-56,-30,-,-)
#
# ---------
# Title Area
# ---------
#
# Time (on Quickscreen); the sleep timer is the WPS's alone
%Vl(status,30,30,-256,34,3)
%?if(%cs,!=,10)<|%?cf<%cH:%cM|%cl:%cM %cP>>
#
# Battery text and icon, and left of it the Bluetooth rune, Wi-Fi, and what
# else is on: the padlock while the touch lock is, the jack or the receiver,
# the database drum while it builds or is not ready
%V(-256,30,-30,32,3)
%ar%bl%%%?bp<%xd(batt_chg)|%xd(batt,%bl)>%xd(bt,%BT)%xd(wifi,%WF)%?mh<%xd(lock,1)%?Bw<%xd(wired2)|%?Br<%?Dd<|%xd(db2,1)|%xd(db2,2)>|%xd(rx2,1)|%xd(rx2,2)>>|%?Bw<%xd(wired)%?Dd<|%xd(db2,1)|%xd(db2,2)>|%?Br<%?Dd<|%xd(db,1)|%xd(db,2)>|%xd(rx,1)%?Dd<|%xd(db2,1)|%xd(db2,2)>|%xd(rx,2)%?Dd<|%xd(db2,1)|%xd(db2,2)>>>>
#
# Title
%Vl(title, 30,62,-30,60,5)
%s%al%Lt
#
# Line below title
%Vl(title,30,122,-30,30,-)
%dr(0,4,-,2)
#
# Title and its line with the joystick plate up: in the status row
%Vl(title_p,30,14,-256,60,5)
%s%al%Lt
%Vl(rule_p,30,74,-30,30,-)
%dr(0,4,-,2)
#
# When menu has no title
%Vl(no_title,30,62,-30,90,5)
#
# Volume (dB)
%Vl(vol,30,30,110,62,4)
%Vs(invert)%ac%pv
#
# Volume bar
%Vl(vol,30,110,-30,36,-)
%pv(0,0,-,-,vb,backdrop,vb_backdrop)
%?if(%pv, >, 0)<%pv(0,0,-,-,vb_too_loud,backdrop,vb_backdrop)>
#
# ---------
# UI viewport
# ---------
%Vi(main,30,152,-30,-104,-)
%Vi(main_l,30,152,-30,-56,-)
%Vi(main_p,30,104,-30,-338,-)
%Vi(USB,30,152,2,2,-)
#
# Plugged in: a clock for the desk, after SNAZZY's USB screen (Phil Graves,
# CC-BY-SA) - what it is, the date, the time to the second, the battery,
# and the warning blinking at the foot.
%Vl(USB,30,170,-30,50,4)
%Vs(invert)%acUSB CONNECTED
#
%Vl(USB,30,300,-30,40,3)
%ac%s%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cd %?cm<January|February|March|April|May|June|July|August|September|October|November|December>
#
%Vl(USB,30,350,-30,70,5)
%ac%?cf<%cH:%cM:%cS|%cl:%cM:%cS %cP>
#
%Vl(USB,30,440,-30,40,3)
%ac%?bp<CHARGING |>%bl%%
#
%Vl(USB,30,600,-30,2,-)
%dr(0,0,-,2)
#
%Vl(USB,30,612,-30,40,3)
%ac%t(1)EJECT BEFORE DISCONNECTING;%t(0.2)%ac
#
# ---------
# Footer
# ---------
%Vl(main,30,-104,-30,-60,-)
%dr(0,24,-,2)
#
# The cover of what is playing, the height of the title line, left of it.
# 34 px is its own album-art size, so buffering scales a copy for it; the
# WPS keeps its big one.
%Vl(npart,30,-60,34,34,-)
%Cl(0,0,34,34,c,c)
%Cd
#
# No cover: a note, drawn, because the fonts here have no note glyph.
%Vl(npnote,30,-60,34,34,-)
%dr(0,0,-,-,3A3B3D,3A3B3D)
%dr(8,20,12,9)
%dr(18,6,3,20)
%dr(18,6,10,4)
#
%Vl(main,72,-60,-60,-,3)
%al%s%?rs<%rs|%?it<%it|%fn>>
#
%Vl(main,-60,-60,-30,-,-)
%?if(%mp,=,3)<%xd(p)>
#