#
#  Snappy V2 status bar - Chris Soffke's Snappy 1.3 SBS, unchanged except
#  for the font, which is Geist Mono here so that Vietnamese renders.
#
#  ____ _  _ ____ ___  ___  _   _
#  [__  |\ | |__| |__] |__]  \_/
#  ___] | \| |  | |    |      |
#
#  v 1.3 2026
#  Chris Soffke
#  CC-BY-SA
#
#  480x800 version, mechanically scaled 2x from the author's 240x320
#  release (coordinates, bitmaps, and font sizes). The layout is
#  unchanged; fonts were re-rendered from Kode Mono at 2x size.
#
#  Remix of Simon Andén's SNARTY, rewritten for 240x320px.
#
#  Based on original design by
#  Chuck Lardo (SPAZZ), plus further work by
#  Jihoon Kim (SNAZZ/SNAZZ2),
#  Phil Graves (SNAZZY), and
#  Evan Dook (Adwaitapod)
#
%Fl(3,31-GeistMono-SemiBold.fnt)
%Fl(4,44-GeistMono-SemiBold.fnt)
%Fl(5,58-GeistMono-SemiBold.fnt)
%xl(batt,batt_sbs.bmp,96,6,11)
%xl(batt_chg,batt_sbs_chg.bmp,96,6)
%xl(vb,vb.bmp)
%xl(vb_backdrop,vb_backdrop.bmp)
%xl(vb_too_loud,vb_too_loud.bmp)
%?mv(1.5)<%Vd(vol)|%Vd(status)%?Lt<%Vd(title)|%Vd(no_title)>>
%?if(%cs, =, 21)<%Vd(USB)%VI(USB)|%?mp<%VI(main_l)%Vd(main_l)|%VI(main)%Vd(main)>>
#
# ---------
# Margins
# ---------
# t (also displays disk activity)
%V(0,0,-30,30,3)
%?if(%lh,=,h)<%ar%t(0.5);%ar%t(0.5).;%ar%t(0.5)..;%ar%t(0.5)...|       >
# l
%V(0,0,30,-,-)
# r
%V(-30,0,-,-,-)
# b (when footer is hidden)
%Vl(main_l,30,-56,-30,-,-)
#
# ---------
# Title Area
# ---------
#
# Locked indicator / Time (on Quickscreen) or sleep timer
%Vl(status,30,30,-240,34,3)
%?mh<%Vs(invert)%acLOCKED|%?if(%cs,!=,10)<%?bs<%bs zzz...>|%?cf<%cH:%cM|%cl:%cM %cP>>>
#
# Battery text and icon
%V(-240,30,-30,32,3)
%ar%bl%%%?bp<%xd(batt_chg)|%xd(batt,%bl)>
#
# Title
%Vl(title, 30,62,-30,60,5)
%s%al%Lt
#
# Line below title
%Vl(title,30,122,-30,30,-)
%dr(0,4,-,2)
#
# When menu has no title
%Vl(no_title,30,62,-30,90,5)
#
# Volume (dB)
%Vl(vol,30,30,110,62,4)
%Vs(invert)%ac%pv
#
# Volume bar
%Vl(vol,30,110,-30,36,-)
%pv(0,0,-,-,vb,backdrop,vb_backdrop)
%?if(%pv, >, 0)<%pv(0,0,-,-,vb_too_loud,backdrop,vb_backdrop)>
#
# ---------
# UI viewport
# ---------
%Vi(main,30,152,-30,-104,-)
%Vi(main_l,30,152,-30,-56,-)
%Vi(USB,30,152,2,2,-)
#
%Vl(USB,30,154,-30,-56,5)
%Vs(invert)%acEJECT
%acBEFORE
%acDISCONNECTING
#
# ---------
# Footer
# ---------
%Vl(main,30,-104,-30,-60,-)
%dr(0,24,-,2)
#
%Vl(main,30,-60,-60,-,3)
%al%s%?it<%it|%fn>
#
%Vl(main,-60,-60,-30,-,-)
%?if(%mp,=,3)<%x(p,paused.bmp,12,8)>
#